___TESTS___

scenarios:
- name: Reports tags as JSON POST to ingest endpoint
  code: |-
    const JSON = require('JSON');
    const mockData = { endpoint: 'https://example.com/collect', siteToken: 'nnd-dev-3f9a', sampleRate: '100' };
    mock('generateRandom', (min, max) => 1);
    mock('getEventData', (key) => 'purchase');
    mock('getClientName', () => 'GA4');
    mock('getContainerVersion', () => ({ version: '7' }));
    let cb;
    mock('addEventCallback', (fn) => { cb = fn; });
    let sentUrl, sentBody, sentOptions;
    mock('sendHttpRequest', (url, callback, options, body) => {
      sentUrl = url; sentOptions = options; sentBody = body;
      callback(204, {}, '');
    });
    runCode(mockData);
    assertApi('gtmOnSuccess').wasCalled();
    cb('GTM-SRV1', { tags: [ { id: 3, name: 'Meta CAPI', status: 'success', executionTime: 88 } ]});
    assertThat(sentUrl).isEqualTo('https://example.com/collect');
    assertThat(sentOptions.method).isEqualTo('POST');
    const parsed = JSON.parse(sentBody);
    assertThat(parsed.t).isEqualTo('nnd-dev-3f9a');
    assertThat(parsed.cid).isEqualTo('GTM-SRV1');
    assertThat(parsed.en).isEqualTo('purchase');
    assertThat(parsed.cn).isEqualTo('GA4');
    assertThat(parsed.tags.length).isEqualTo(1);
    assertThat(parsed.tags[0].id).isEqualTo('3');
    assertThat(parsed.tags[0].st).isEqualTo('success');
- name: Sampled-out events register no callback
  code: |-
    const mockData = { endpoint: 'https://example.com/collect', siteToken: 'nnd-dev-3f9a', sampleRate: '10' };
    mock('generateRandom', (min, max) => 50);
    let cbRegistered = false;
    mock('addEventCallback', (fn) => { cbRegistered = true; });
    runCode(mockData);
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('sendHttpRequest').wasNotCalled();
    assertThat(cbRegistered).isEqualTo(false);
- name: Excluded tags filtered and empty events send nothing
  code: |-
    const mockData = { endpoint: 'https://example.com/collect', siteToken: 'nnd-dev-3f9a', sampleRate: '100' };
    mock('generateRandom', (min, max) => 1);
    mock('getEventData', (key) => 'page_view');
    mock('getClientName', () => 'GA4');
    mock('getContainerVersion', () => ({ version: '7' }));
    let cb;
    mock('addEventCallback', (fn) => { cb = fn; });
    runCode(mockData);
    cb('GTM-SRV1', { tags: [ { id: 9, name: 'Monitor', status: 'success', executionTime: 1, exclude: 'true' } ]});
    assertApi('sendHttpRequest').wasNotCalled();
- name: The hostname is sent, and only ever the host
  code: |-
    const JSON = require('JSON');
    const mockData = { endpoint: 'https://example.com/collect', siteToken: 'nnd-dev-3f9a', sampleRate: '100' };
    mock('generateRandom', (min, max) => 1);
    // A path on the value must never survive: the path is where the personal
    // data lives, an order id or a search term.
    mock('getEventData', (key) => key === 'page_hostname'
      ? 'www.one2track.de/checkout/thanks?order=12345'
      : (key === 'event_name' ? 'page_view' : undefined));
    mock('getClientName', () => 'GA4');
    mock('getContainerVersion', () => ({ version: '7' }));
    let cb;
    mock('addEventCallback', (fn) => { cb = fn; });
    let sentBody;
    mock('sendHttpRequest', (url, callback, options, body) => { sentBody = body; callback(204, {}, ''); });
    runCode(mockData);
    cb('GTM-SRV1', { tags: [ { id: 3, name: 'Meta CAPI', status: 'success', executionTime: 5 } ]});
    const parsed = JSON.parse(sentBody);
    assertThat(parsed.h).isEqualTo('www.one2track.de');
- name: No hostname is sent when the event carries none
