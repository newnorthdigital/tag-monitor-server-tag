___SANDBOXED_JS_FOR_SERVER___

// NND Tag Monitor (server leg). Fork of Simo Ahava's Server Container Monitor
// (Apache 2.0), with sendHttpRequest to the NND ingest endpoint instead of a
// direct BigQuery insert, so no per-client IAM grants are needed.
const addEventCallback = require('addEventCallback');
const sendHttpRequest = require('sendHttpRequest');
const getEventData = require('getEventData');
const getAllEventData = require('getAllEventData');
const getType = require('getType');
const makeTableMap = require('makeTableMap');
const getClientName = require('getClientName');
const getContainerVersion = require('getContainerVersion');
const getTimestampMillis = require('getTimestampMillis');
const generateRandom = require('generateRandom');
const makeInteger = require('makeInteger');
const makeString = require('makeString');
const makeNumber = require('makeNumber');
const JSON = require('JSON');
const logToConsole = require('logToConsole');

const debugLog = (msg) => {
  if (data.debug) logToConsole('NND Tag Monitor - ' + msg);
};


const sampleRate = makeInteger(data.sampleRate) || 100;
if (generateRandom(1, 100) > sampleRate) {
  data.gtmOnSuccess();
  return;
}

const eventName = makeString(getEventData('event_name') || '');
const clientName = getClientName();
const containerVersion = getContainerVersion();
const eventTimestamp = getTimestampMillis();

// GA4's own required parameters per ecommerce event, from
// developers.google.com/analytics/devguides/collection/ga4/reference/events.
// Platforms reject or mis-attribute conversions that arrive without these, and
// the omission is invisible in GTM itself: the tag fires successfully with an
// incomplete payload.
const REQUIRED = {
  purchase: ['transaction_id', 'value', 'currency', 'items'],
  refund: ['transaction_id', 'value', 'currency'],
  add_to_cart: ['value', 'currency', 'items'],
  begin_checkout: ['value', 'currency', 'items'],
  add_payment_info: ['value', 'currency', 'items'],
  add_shipping_info: ['value', 'currency', 'items'],
  add_to_wishlist: ['value', 'currency', 'items'],
  view_item: ['items'],
  view_item_list: ['items'],
  select_item: ['items'],
  view_cart: ['items'],
  remove_from_cart: ['items'],
  generate_lead: ['value', 'currency']
};

const missingParams = () => {
  if (!data.checkParams || eventName === '') return '';

  let required = REQUIRED[eventName];
  // Only accept a real array: event_name is attacker-controlled, and indexing
  // by something like 'constructor' would otherwise yield a non-array.
  if (getType(required) !== 'array') required = null;
  const custom = data.customRequired ? makeTableMap(data.customRequired, 'eventName', 'params') : null;
  if (custom && custom[eventName]) {
    const extra = makeString(custom[eventName]).split(',');
    required = required ? required.concat(extra) : extra;
  }
  if (!required || required.length === 0) return '';

  const all = getAllEventData();
  const ecommerce = getType(all.ecommerce) === 'object' ? all.ecommerce : {};
  const missing = [];
  for (let i = 0; i < required.length; i++) {
    const key = makeString(required[i]).trim();
    if (key === '') continue;
    // The GA4 client flattens ecommerce fields to the top level, a Data Client
    // keeps them nested. Check both before calling a parameter missing.
    const value = getType(all[key]) === 'undefined' ? ecommerce[key] : all[key];
    const type = getType(value);
    // Absent, null, empty string or empty items array all count as missing.
    const empty = type === 'undefined' || type === 'null' || value === '' ||
      (type === 'array' && value.length === 0);
    if (empty && missing.indexOf(key) === -1) missing.push(key);
  }

  // GA4 requires every item to carry item_id or item_name. A purchase whose
  // items array is present but anonymous still reports fine and still breaks
  // product-level reporting and dynamic ads, so it is worth its own check.
  // User-provided data on conversions, per GA4's uid-data reference. Only the
  // NAME of a missing field is ever reported: the values are personal data,
  // hashed or not, and must never leave the container.
  if (eventName === 'purchase' || eventName === 'generate_lead') {
    const ud = getType(all.user_data) === 'object' ? all.user_data : {};
    const present = (a, b) => getType(ud[a]) !== 'undefined' || getType(ud[b]) !== 'undefined';
    if (!present('sha256_email_address', 'email_address')) missing.push('user_data.email');
    if (!present('sha256_phone_number', 'phone_number')) missing.push('user_data.phone');
    if (getType(ud.address) === 'undefined') missing.push('user_data.address');
  }

  const items = getType(all.items) === 'array' ? all.items : ecommerce.items;
  if (getType(items) === 'array' && items.length > 0) {
    const first = items[0];
    if (getType(first) === 'object') {
      const hasId = getType(first.item_id) !== 'undefined' && first.item_id !== '';
      const hasName = getType(first.item_name) !== 'undefined' && first.item_name !== '';
      if (!hasId && !hasName) missing.push('items.item_id');
    }
  }
  return missing.join(',');
};

const missing = missingParams();

// Amounts are opt-in: they turn a count into something a client can weigh,
// but they are their commercial figures, so nobody sends them by accident.
const eventValue = () => {
  if (!data.sendValue) return -1;
  const all = getAllEventData();
  const ecom = getType(all.ecommerce) === 'object' ? all.ecommerce : {};
  const raw = getType(all.value) === 'undefined' ? ecom.value : all.value;
  const num = makeNumber(raw);
  return getType(num) === 'number' && num > 0 ? num : -1;
};
const eventCurrency = () => {
  if (!data.sendValue) return '';
  const all = getAllEventData();
  const ecom = getType(all.ecommerce) === 'object' ? all.ecommerce : {};
  return makeString((getType(all.currency) === 'undefined' ? ecom.currency : all.currency) || '');
};
const value = eventValue();
const currency = eventCurrency();

addEventCallback((containerId, eventData) => {
  const tags = eventData.tags
    .filter((tag) => tag.exclude !== 'true')
    .map((tag) => ({
      id: makeString(tag.id),
      nm: makeString(tag.name || ''),
      st: makeString(tag.status || ''),
      et: makeInteger(tag.executionTime) || 0
    }));
  if (tags.length === 0) return;

  const body = {
    t: data.siteToken,
    cid: containerId,
    cv: makeString(containerVersion.version || ''),
    en: eventName,
    ets: eventTimestamp,
    cn: clientName,
    sr: sampleRate,
    tags: tags
  };
  // Only sent when something is actually missing, so the receiving side only
  // ever stores problem rows.
  if (missing !== '') body.mp = missing;
  if (value > 0) {
    body.v = value;
    body.cur = currency;
  }

  debugLog('reporting ' + tags.length + ' tags for event ' + eventName);
  sendHttpRequest(data.endpoint, (statusCode) => {
    // Error log is unconditional and the logging permission is set to "all":
    // a failure that only logs in preview is invisible exactly when it matters.
    if (statusCode >= 400 || statusCode <= 0) {
      logToConsole('NND Tag Monitor - ingest failed with status ' + statusCode);
    }
  }, {
    headers: { 'Content-Type': 'application/json' },
    method: 'POST',
    timeout: 3000
  }, JSON.stringify(body));
});

// Fire-and-forget: don't block the container response on the callback's I/O.
data.gtmOnSuccess();


